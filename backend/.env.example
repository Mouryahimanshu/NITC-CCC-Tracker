APP_NAME=NITC CCC Terminal Booking Tracker API
APP_ENV=development
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Neon/PostgreSQL pooled connection string from the Neon dashboard.
DATABASE_URL=
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-running-auth
ACCESS_TOKEN_MINUTES=30
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_FACULTY_USERNAME=
BOOTSTRAP_FACULTY_DISPLAY_NAME=CCC Faculty
BOOTSTRAP_FACULTY_PASSWORD=
GMAIL_MAILBOX=
GMAIL_CLIENT_SECRET_FILE=
GMAIL_TOKEN_FILE=token.json
GMAIL_POLL_SECONDS=120
GMAIL_ALLOWED_SENDERS=maincc@nitc.ac.in
GMAIL_INITIAL_UID=0

# Browser development origin. Use a comma-separated allowlist when expanded.
FRONTEND_ORIGIN=http://localhost:5173

# Confirmed project settings.
CAMPUS_TIMEZONE=Asia/Kolkata
BOOKING_SLOT_MINUTES=30
